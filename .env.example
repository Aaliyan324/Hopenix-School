# ===========================================
# Hopenix School — Environment Variables
# ===========================================

# Database Connection (Neon / Supabase / Vercel Postgres)
# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@ep-example-123456.us-east-1.aws.neon.tech/hopenix_db?sslmode=require"

# Direct URL for Prisma Migrations (if using Neon/Supabase transaction poolers)
DIRECT_URL="postgresql://user:password@ep-example-123456.us-east-1.aws.neon.tech/hopenix_db?sslmode=require"

# Authentication JWT Secret
JWT_SECRET="hopenix-production-jwt-secret-key-change-in-prod-2026"

# Vercel Blob Storage Token (Optional - for attachment & file uploads)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_token_here"
